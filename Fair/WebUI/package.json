{
  "name": "fair.webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "sync": "node tools/sync-with-node.ts",
    "sync:check": "node tools/sync-with-node.ts --check",
    "prebuild": "npm run sync",
    "build": "tsc -b && vite build",
    "build:serverless": "cross-env VITE_APP_SERVERLESS_BUILD=1 npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint --fix . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.9",
    "@tanstack/react-query": "^5.64.1",
    "i18next": "^26.4.0",
    "lodash": "^4.17.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "react-select": "^5.10.1",
    "react-toastify": "^11.0.5",
    "swiper": "^14.0.2",
    "tailwind-merge": "^2.6.0",
    "usehooks-ts": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,html}": [
      "prettier --write"
    ]
  }
}
